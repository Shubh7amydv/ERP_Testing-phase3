{
  "info": {
    "name": "ERP Hostel API",
    "description": "Hostel Module - All Endpoints\n\nEndpoints:\n- Hostels (CRUD)\n- Hostel Rooms (CRUD)\n- Hostel Allocations (CRUD)\n- Hostel Fees (CRUD)\n- Hostel Attendance (CRUD + bulk)\n- Hostel Visitors (CRUD)\n- Hostel Mess Menu (CRUD)\n- Reports (occupancy, fee-collection)\n\nAll endpoints require Bearer token authentication.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "base_url",
      "value": "http://127.0.0.1:8000/api"
    },
    {
      "key": "access_token",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "Hostels",
      "item": [
        {
          "name": "List Hostels",
          "request": {
            "method": "GET",
            "url": "{{base_url}}/hostels/",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{access_token}}"
              }
            ]
          }
        },
        {
          "name": "Create Hostel",
          "request": {
            "method": "POST",
            "url": "{{base_url}}/hostels/",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{access_token}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Boys Hostel A\",\n  \"type\": \"boys\",\n  \"address\": \"Block A, Campus Road\",\n  \"warden\": \"Mr. Sharma\",\n  \"contact\": \"9876543210\",\n  \"total_rooms\": 50,\n  \"capacity\": 200,\n  \"is_active\": true\n}"
            }
          }
        },
        {
          "name": "Get Hostel Detail",
          "request": {
            "method": "GET",
            "url": "{{base_url}}/hostels/1/",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{access_token}}"
              }
            ]
          }
        },
        {
          "name": "Update Hostel",
          "request": {
            "method": "PUT",
            "url": "{{base_url}}/hostels/1/",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{access_token}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Boys Hostel A Updated\",\n  \"type\": \"boys\",\n  \"address\": \"Block A, Campus Road\",\n  \"warden\": \"Mr. Verma\",\n  \"contact\": \"9876543211\",\n  \"total_rooms\": 60,\n  \"capacity\": 240,\n  \"is_active\": true\n}"
            }
          }
        },
        {
          "name": "Delete Hostel",
          "request": {
            "method": "DELETE",
            "url": "{{base_url}}/hostels/1/",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{access_token}}"
              }
            ]
          }
        }
