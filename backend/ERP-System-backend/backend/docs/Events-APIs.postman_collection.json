            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{access_token}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"event\": 1,\n  \"exam\": 1,\n  \"classes\": [1, 2, 3]\n}"
            }
          }
        },
        {
          "name": "Get Exam Event Detail",
          "request": {
            "method": "GET",
            "url": "{{base_url}}/exam-events/1/",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{access_token}}"
              }
            ]
          }
        },
        {
          "name": "Delete Exam Event",
          "request": {
            "method": "DELETE",
            "url": "{{base_url}}/exam-events/1/",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{access_token}}"
              }
            ]
          }
        }
      ]
    },
    {
      "name": "School Calendars",
      "item": [
        {
          "name": "List School Calendars",
          "request": {
            "method": "GET",
            "url": "{{base_url}}/school-calendars/",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{access_token}}"
              }
            ]
          }
        },
        {
          "name": "Create School Calendar",
          "request": {
            "method": "POST",
            "url": "{{base_url}}/school-calendars/",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{access_token}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"academic_year\": 1,\n  \"name\": \"Academic Calendar 2025-26\",\n  \"year\": 2025,\n  \"is_published\": false\n}"
            }
          }
        },
        {
          "name": "Get School Calendar Detail",
          "request": {
            "method": "GET",
            "url": "{{base_url}}/school-calendars/1/",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{access_token}}"
              }
            ]
          }
        },
        {
          "name": "Update School Calendar",
          "request": {
            "method": "PUT",
            "url": "{{base_url}}/school-calendars/1/",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{access_token}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"academic_year\": 1,\n  \"name\": \"Academic Calendar 2025-26\",\n  \"year\": 2025,\n  \"is_published\": true\n}"
            }
          }
        },
        {
          "name": "Delete School Calendar",
          "request": {
            "method": "DELETE",
            "url": "{{base_url}}/school-calendars/1/",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{access_token}}"
              }
            ]
          }
        }
      ]
    }
  ]
}
