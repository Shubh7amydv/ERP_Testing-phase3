{
  "info": {
    "name": "ERP Events API",
    "description": "Events Module - All Endpoints\n\nEndpoints:\n- Event Types (CRUD)\n- Events (CRUD)\n- Exam Events (CRUD)\n- School Calendars (CRUD)\n\nAll endpoints require Bearer token authentication.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "base_url",
      "value": "http://127.0.0.1:8000/api"
    },
    {
      "key": "access_token",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "Event Types",
      "item": [
        {
          "name": "List Event Types",
          "request": {
            "method": "GET",
            "url": "{{base_url}}/event-types/",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{access_token}}"
              }
            ]
          }
        },
        {
          "name": "Create Event Type",
          "request": {
            "method": "POST",
            "url": "{{base_url}}/event-types/",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{access_token}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Holiday\",\n  \"color\": \"#FF5733\",\n  \"is_active\": true\n}"
            }
          }
        },
        {
          "name": "Get Event Type Detail",
          "request": {
            "method": "GET",
            "url": "{{base_url}}/event-types/1/",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{access_token}}"
              }
            ]
          }
        },
        {
          "name": "Update Event Type",
          "request": {
            "method": "PUT",
            "url": "{{base_url}}/event-types/1/",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{access_token}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Holiday Updated\",\n  \"color\": \"#FF0000\",\n  \"is_active\": true\n}"
            }
          }
        },
        {
          "name": "Delete Event Type",
          "request": {
            "method": "DELETE",
            "url": "{{base_url}}/event-types/1/",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{access_token}}"
              }
            ]
          }
        }
      ]
    },
    {
      "name": "Events",
      "item": [
        {
          "name": "List Events",
          "request": {
            "method": "GET",
            "url": "{{base_url}}/events/",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{access_token}}"
              }
            ]
          }
        },
        {
          "name": "Create Event",
          "request": {
            "method": "POST",
            "url": "{{base_url}}/events/",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{access_token}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"event_type\": 1,\n  \"title\": \"Annual Day Celebration\",\n  \"description\": \"School annual day function\",\n  \"start_date\": \"2025-12-20\",\n  \"end_date\": \"2025-12-20\",\n  \"location\": \"School Auditorium\",\n  \"is_holiday\": true,\n  \"target_audience\": \"all\"\n}"
            }
          }
        },
        {
          "name": "Get Event Detail",
          "request": {
            "method": "GET",
            "url": "{{base_url}}/events/1/",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{access_token}}"
              }
            ]
          }
        },
        {
          "name": "Update Event",
          "request": {
            "method": "PUT",
            "url": "{{base_url}}/events/1/",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{access_token}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"event_type\": 1,\n  \"title\": \"Annual Day Updated\",\n  \"description\": \"Updated description\",\n  \"start_date\": \"2025-12-21\",\n  \"end_date\": \"2025-12-21\",\n  \"location\": \"Main Hall\",\n  \"is_holiday\": true,\n  \"target_audience\": \"all\"\n}"
            }
          }
        },
        {
          "name": "Delete Event",
          "request": {
            "method": "DELETE",
            "url": "{{base_url}}/events/1/",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{access_token}}"
              }
            ]
          }
        }
      ]
    },
