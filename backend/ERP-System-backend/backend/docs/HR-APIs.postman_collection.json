{
  "info": {
    "name": "ERP HR API",
    "description": "HR Module - All Endpoints\n\nEndpoints:\n- Departments (CRUD)\n- Designations (CRUD)\n- Staff (CRUD)\n- Staff Attendance (CRUD + bulk)\n- Leave Types (CRUD)\n- Staff Leaves (CRUD)\n- Payroll Months (CRUD)\n- Salary Slips (CRUD)\n- Salary Components (CRUD)\n- Reports (staff-list, payroll-summary, attendance-summary, leave-summary, pf-report, esi-report)\n\nAll endpoints require Bearer token authentication.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "base_url",
      "value": "http://127.0.0.1:8000/api"
    },
    {
      "key": "access_token",
      "value": ""
    }
  ],
