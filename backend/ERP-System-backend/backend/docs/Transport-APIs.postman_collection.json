{
  "info": {
    "name": "ERP Transport API",
    "description": "Transport Module - All Endpoints\n\nEndpoints:\n- Bus Routes (CRUD)\n- Buses (CRUD)\n- Bus Route Fees (CRUD)\n- Admission Bus Details (CRUD)\n- Reports (route-wise, collection)\n\nAll endpoints require Bearer token authentication.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "base_url",
      "value": "http://127.0.0.1:8000/api"
    },
    {
      "key": "access_token",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "Bus Routes",
      "item": [
        {
          "name": "List Bus Routes",
          "request": {
            "method": "GET",
            "url": "{{base_url}}/bus-routes/",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{access_token}}"
              }
            ]
          }
        },
        {
          "name": "Create Bus Route",
          "request": {
            "method": "POST",
            "url": "{{base_url}}/bus-routes/",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{access_token}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Route A - Downtown\",\n  \"start_point\": \"Central Bus Stand\",\n  \"end_point\": \"School Gate\",\n  \"distance_km\": 12.5,\n  \"stops\": [\"Market Square\", \"City Hospital\", \"Park Road\"],\n  \"morning_time\": \"07:30:00\",\n  \"evening_time\": \"15:30:00\",\n  \"is_active\": true\n}"
            }
          }
        },
        {
          "name": "Get Bus Route Detail",
          "request": {
            "method": "GET",
            "url": "{{base_url}}/bus-routes/1/",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{access_token}}"
              }
            ]
          }
        },
        {
          "name": "Update Bus Route",
          "request": {
            "method": "PUT",
            "url": "{{base_url}}/bus-routes/1/",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{access_token}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Route A - Downtown Updated\",\n  \"start_point\": \"Central Bus Stand\",\n  \"end_point\": \"School Gate\",\n  \"distance_km\": 13.0,\n  \"stops\": [\"Market Square\", \"City Hospital\", \"Park Road\", \"New Stop\"],\n  \"morning_time\": \"07:15:00\",\n  \"evening_time\": \"15:30:00\",\n  \"is_active\": true\n}"
            }
          }
        },
        {
          "name": "Delete Bus Route",
          "request": {
            "method": "DELETE",
            "url": "{{base_url}}/bus-routes/1/",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{access_token}}"
              }
            ]
          }
        }
      ]
    },
    {
      "name": "Buses",
