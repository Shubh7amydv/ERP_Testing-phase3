              "raw": "{\n  \"bus_number\": \"MH-12-AB-1234\",\n  \"capacity\": 40,\n  \"driver_name\": \"Suresh Driver\",\n  \"driver_phone\": \"9876543210\",\n  \"conductor_name\": \"Mohan Conductor\",\n  \"conductor_phone\": \"9876543211\",\n  \"status\": \"active\",\n  \"is_active\": true\n}"
